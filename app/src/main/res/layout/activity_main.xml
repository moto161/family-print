<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceVariant">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="家庭打印"
                android:textSize="22sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorOnSurface" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF · Word · Excel · 图片"
                android:textSize="@dimen/text_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <!-- 中间可滚动区域（支持下拉刷新连接状态） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp">

            <!-- 连接状态卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="连接状态"
                        android:textSize="15sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_status_row">
                        <ImageView android:id="@+id/dotServer" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/dot_checking" android:scaleType="fitXY" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="阿里云服务器" android:textSize="14sp" android:layout_marginStart="12dp" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tvServerStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="检测中..." android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="12dp"
                        android:background="@drawable/bg_status_row">
                        <ImageView android:id="@+id/dotPrinter" android:layout_width="10dp" android:layout_height="10dp" android:src="@drawable/dot_checking" android:scaleType="fitXY" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="打印机（隧道）" android:textSize="13sp" android:layout_marginStart="10dp" android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView android:id="@+id/tvPrinterStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="检测中..." android:textSize="12sp" android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 选择文件按钮 -->
            <Button
                android:id="@+id/btnSelect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="选择文件"
                android:textSize="15sp"
                android:textColor="?attr/colorOnPrimary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginBottom="12dp" />

            <!-- 证件复印入口 -->
            <Button
                android:id="@+id/btnIdCopy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="证件复印（身份证正反面合成一页 A4）"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/bg_button_quantity"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="拍照打印（拍下文件立即进入打印流程）"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@drawable/bg_button_quantity"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="未选择文件"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="14dp"
                android:background="@drawable/bg_file_chip"
                android:layout_marginBottom="12dp" />

            <!-- 文件预览卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="文件预览"
                        android:textSize="15sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tvPageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="共 0 页"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginBottom="10dp" />
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/llThumbnails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="2dp" />
                    </HorizontalScrollView>
                    <TextView
                        android:id="@+id/tvSelectedPages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="已选：全部"
                        android:textSize="12sp"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        android:background="?attr/colorPrimaryContainer" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">
                        <Button android:id="@+id/btnSelectAll" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="全选" android:textSize="13sp" android:textColor="?attr/colorOnSurface" android:background="@android:color/transparent" android:minWidth="0dp" />
                        <Button android:id="@+id/btnDelete" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="删除" android:textSize="13sp" android:textColor="?attr/colorError" android:background="@android:color/transparent" android:minWidth="0dp" />
                        <Button android:id="@+id/btnClearAll" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="清空" android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant" android:background="@android:color/transparent" android:minWidth="0dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 空状态引导 -->
            <LinearLayout
                android:id="@+id/emptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:text="打印"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:background="@drawable/bg_thumbnail"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="还没有选择文件"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="支持 PDF / Word / Excel / 图片"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="20dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="1"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_button_primary"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择文件"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="2"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_button_primary"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="预览选页"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="→"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:text="3"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_button_primary"
                            android:layout_marginBottom="4dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="开始打印"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 加载进度条 -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp"
                android:progressTint="?attr/colorPrimary"
                android:progressBackgroundTint="?attr/colorOutline" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 底部打印操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="?attr/colorSurface"
        android:elevation="2dp">
        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="开始打印"
            android:textSize="16sp"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/bg_button_primary"
            android:enabled="false" />
    </LinearLayout>

    <!-- 底部导航 -->
    <include layout="@layout/bottom_nav" />

</LinearLayout>
