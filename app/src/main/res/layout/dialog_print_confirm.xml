<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 打印摘要卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打印摘要"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="文件数"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvFileCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 个"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="总页数"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvPageCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 页"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="打印方向"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvOrientation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="纵向 0 页，横向 0 页"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="预计时间"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                        <TextView
                            android:id="@+id/tvEstTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="约 0 秒"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 打印份数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="打印份数"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@drawable/bg_button_quantity"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <TextView
                    android:id="@+id/tvCopies"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:text="1 份"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface"
                    android:gravity="center"
                    android:background="?attr/colorSurfaceVariant" />

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@drawable/bg_button_quantity"
                    android:layout_marginStart="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- 纸张大小 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="纸张大小"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:id="@+id/btnPaperA4"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="A4"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnPrimary"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btnPaperA5"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="A5"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_button_quantity"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- N合一省纸 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="N 合一省纸"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:id="@+id/btnNup1"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:text="1合1"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnPrimary"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btnNup2"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:text="2合1"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_button_quantity"
                    android:layout_marginEnd="6dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btnNup4"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:text="4合1"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_button_quantity"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- 省墨模式（Toner Save，降低碳粉用量） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="省墨模式"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:id="@+id/btnEcoOff"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="标准"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnPrimary"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btnEcoOn"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="省墨"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_button_quantity"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <!-- 双面打印（P2200NW 无自动双面，走驱动 ManualDuplex：奇数面打完按提示翻纸） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="双面打印"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/colorOnSurface" />

                <Button
                    android:id="@+id/btnDuplexOff"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="单面"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnPrimary"
                    android:background="@drawable/bg_button_primary"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

                <Button
                    android:id="@+id/btnDuplexOn"
                    android:layout_width="72dp"
                    android:layout_height="40dp"
                    android:text="双面"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:background="@drawable/bg_button_quantity"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部操作栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="?attr/colorSurface">

        <Button
            android:id="@+id/btnSheetCancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:text="取消"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:background="@drawable/bg_button_quantity" />

        <Button
            android:id="@+id/btnSheetPrint"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="开始打印"
            android:textSize="15sp"
            android:textColor="?attr/colorOnPrimary"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>

</LinearLayout>
