<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurfaceVariant">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="?attr/colorSurface">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="返回"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:background="?attr/colorSurfaceVariant"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textSize="20sp"
            android:textStyle="normal"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/colorOnSurface"
            android:gravity="center" />

        <View
            android:layout_width="80dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutline" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 外观主题切换 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="外观主题"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardThemeModern"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1.5dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">
                                <View
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_theme_modern" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="清爽"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardThemeWarm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1.5dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">
                                <View
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_theme_warm" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="暖居"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardThemePro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1.5dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">
                                <View
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_theme_pro" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="专业"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardThemeDark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardCornerRadius="@dimen/radius_card"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:strokeColor="?attr/colorOutline"
                            app:strokeWidth="1.5dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:padding="12dp">
                                <View
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:background="@drawable/bg_theme_dark" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="夜间"
                                    android:textSize="13sp"
                                    android:textColor="?attr/colorOnSurface"
                                    android:layout_marginTop="8dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="切换后立即生效，并自动记住你的选择"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 服务器与连接 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="服务器"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etPrintUrl"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="打印接口地址 http://…/index.php"
                        android:inputType="textUri"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/colorSurfaceVariant"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etAuthToken"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="访问令牌（未启用认证可留空）"
                        android:inputType="textVisiblePassword"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/colorSurfaceVariant"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnTestConnection"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="测试连接"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:background="@drawable/bg_button_quantity"
                        android:layout_marginBottom="4dp" />

                    <!-- 配置分享 / 扫码导入 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <Button
                            android:id="@+id/btnShareConfig"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="分享配置"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface"
                            android:background="@drawable/bg_button_quantity"
                            android:layout_marginEnd="6dp" />

                        <Button
                            android:id="@+id/btnScanConfig"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="扫码导入"
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface"
                            android:background="@drawable/bg_button_quantity"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTestResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 打印机 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="打印机"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etPrinterIp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="局域网IP，如 192.168.1.100"
                        android:inputType="number"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/colorSurfaceVariant"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnUpdatePrinterIp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="更新打印机IP到路由器"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnPrimary"
                        android:background="@drawable/bg_button_primary"
                        android:layout_marginBottom="10dp" />

                    <EditText
                        android:id="@+id/etTunnelAddr"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="隧道地址，如 192.0.2.100:19100"
                        android:inputType="text"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:background="?attr/colorSurfaceVariant"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="隧道用于远程检测打印机在线状态"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 维护 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tvCacheSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="缓存大小: 计算中..."
                            android:textSize="14sp"
                            android:textColor="?attr/colorOnSurface" />
                        <Button
                            android:id="@+id/btnClearCache"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="清理缓存"
                            android:textSize="13sp"
                            android:textColor="?attr/colorError"
                            android:background="?attr/colorErrorContainer"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorOutline"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="版本: v1.66 (点击检查更新)"
                        android:textSize="14sp"
                        android:textColor="?attr/colorPrimary"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="家庭打印助手 - 远程打印到家里的奔图打印机"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 保存按钮 -->
            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="保存设置"
                android:textSize="15sp"
                android:textColor="?attr/colorOnPrimary"
                android:background="@drawable/bg_button_primary"
                android:layout_marginBottom="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部导航 -->
    <include layout="@layout/bottom_nav" />

</LinearLayout>
